#!/usr/bin/env python3
"""herd — minimal lane plumbing for herdr orchestration.

One command per orchestrator intent; all herdr mechanics live here.
Ledger: <project>/.herd/ledger.json  (project = cwd, or HERD_PROJECT).
"""
import fcntl, json, os, re, secrets, subprocess, sys, tempfile, time, tomllib
from contextlib import contextmanager

PROJECT = os.environ.get("HERD_PROJECT", os.getcwd())
HERD_DIR = os.path.join(PROJECT, ".herd")
LEDGER = os.path.join(HERD_DIR, "ledger.json")
WORKTREES = os.path.expanduser("~/.herdr/worktrees")
WORKSPACE = os.environ.get("HERD_WORKSPACE")  # optional herdr workspace for new lanes
SEVERITIES = {"disastrous", "architectural", "blocking", "major", "minor", "nit"}
HANDBACK_SEVS = {"disastrous", "architectural", "blocking"}
LANDABLE = {"reviewed", "done", "user-review"}

KIND_ARGS = {
    "claude": ["--model", "claude-fable-5", "--effort", "high",
               "--permission-mode", "bypassPermissions"],
    "codex": ["-m", "gpt-5.6-sol", "-c", 'model_reasoning_effort="high"',
              "-s", "workspace-write", "-a", "never", "--no-alt-screen"],
    "pi": ["--model", "moonshotai/kimi-k3", "--approve"],
}

FOOTER = ("\n\nFinal message: plain markdown, no box-drawing tables. "
          "End it with a line containing only the token {tok} and nothing else.")

REVIEW_FOOTER = (
    "\n\nWrite every finding to the file {ffile} as a JSON array of objects "
    "{{\"id\": unique short string, "
    "\"severity\": one of disastrous|architectural|blocking|major|minor|nit, "
    "\"file\": path, \"line\": int, \"symptom\": str, \"fix_hint\": str}}. "
    "Write [] if there are none. Severity rule: disastrous/architectural/blocking "
    "only for findings that must be fixed before this work can ship.")

# Dialog doctrine: prevent at launch, otherwise fail closed; see LORE.md.


def die(msg, code=1, **details):
    print(json.dumps({"ok": False, "error": msg, **details}), file=sys.stderr)
    sys.exit(code)


def herdr(*args):
    p = subprocess.run(["herdr", *args], capture_output=True, text=True)
    out = p.stdout.strip() or p.stderr.strip()
    try:
        data = json.loads(out)
    except (json.JSONDecodeError, ValueError):
        data = {"raw": out}
    return p.returncode, data


def git(cwd, *args):
    return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)


def dirty_paths(cwd):
    p = git(cwd, "status", "--porcelain=v1", "-z", "--untracked-files=all")
    paths = {"untracked": [], "modified": []}
    records = p.stdout.split("\0")
    i = 0
    while i < len(records):
        record = records[i]
        i += 1
        if not record:
            continue
        status, path = record[:2], record[3:]
        bucket = "untracked" if status == "??" else "modified"
        paths[bucket].append(path)
        if status != "??" and any(ch in status for ch in "RC") and i < len(records):
            source = records[i]
            i += 1
            if source:
                paths[bucket].append(source)
    return paths


def _refuse_new_home_ledger():
    if (not os.path.exists(LEDGER)
            and os.path.realpath(PROJECT) == os.path.realpath(
                os.path.expanduser("~"))):
        die("refusing to create a ledger in your home directory; cd to the "
            "project or export HERD_PROJECT=<abs project root>")


def baked_flag_arity(kind):
    args = KIND_ARGS.get(kind, [])
    flags = {}
    i = 0
    while i < len(args):
        flag = args[i]
        takes_value = i + 1 < len(args) and not args[i + 1].startswith("-")
        flags[flag] = int(takes_value)
        i += 2 if takes_value else 1
    return flags


def load():
    try:
        with open(LEDGER) as f:
            return json.load(f)
    except FileNotFoundError:
        return {"ship_mode": "scratch", "lanes": {}}
    except json.JSONDecodeError:
        bak = LEDGER + ".corrupt"
        os.replace(LEDGER, bak)
        die(f"ledger was corrupt JSON; moved to {bak} — recover it, do not respawn lanes blindly")


def save(led):
    os.makedirs(HERD_DIR, exist_ok=True)
    tmp = LEDGER + ".tmp"
    with open(tmp, "w") as f:
        json.dump(led, f, indent=1)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, LEDGER)


def mutate(fn):
    """Locked read-modify-write; concurrent herd processes must not clobber
    each other's ledger updates."""
    _refuse_new_home_ledger()
    os.makedirs(HERD_DIR, exist_ok=True)
    with open(os.path.join(HERD_DIR, "lock"), "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        led = load()
        out = fn(led)
        save(led)
        return out


def live_agents():
    _, d = herdr("agent", "list")
    return {a.get("name"): a for a in d.get("result", {}).get("agents", []) if a.get("name")}


def read_pane(target, lines=300):
    _, d = herdr("agent", "read", target, "--source", "recent-unwrapped",
                 "--lines", str(lines))
    text = d.get("result", {}).get("text", d.get("raw", ""))
    if not text.strip():
        # startup dialogs and mid-render reads can be visible-screen only
        _, d = herdr("agent", "read", target, "--source", "visible")
        text = d.get("result", {}).get("text", d.get("raw", ""))
    return text


def agent_info(name):
    rc, d = herdr("agent", "get", name)
    return d.get("result", {}).get("agent", {}) if rc == 0 else {}


def agent_status(name):
    return agent_info(name).get("agent_status")


def agent_revision(name):
    return agent_info(name).get("revision")


def deliver(lane, prompt, evidence, attempts=4, polls=6):
    """Prompt a lane until the pane shows `evidence` or the agent is working.
    Reads can transiently return empty while the agent renders — retry before
    concluding the prompt was eaten; resubmitting onto a working agent
    double-queues. Returns (delivered, attempts, tail)."""
    tail = ""
    for attempt in range(1, attempts + 1):
        rc, _ = herdr("agent", "prompt", lane, prompt)
        for _ in range(polls if rc == 0 else 0):
            time.sleep(2)
            try:
                tail = read_pane(lane)
            except Exception:
                tail = ""
            if (tail and evidence in re.sub(r"\s+", " ", tail).lower()) \
                    or agent_status(lane) == "working":
                return True, attempt, tail
        if agent_status(lane) == "blocked":
            die(f"lane {lane} blocked on a dialog; answer it yourself, "
                f"then resend. pane tail:\n" + tail[-1500:], 3)
        time.sleep(2)  # plain eaten prompt: just resubmit
    return False, attempts, tail


def die_agent_gone(lane, tail, rec, detail="agent is gone", ledger_state=None):
    die(f"lane {lane} {detail}", 2, lane=lane, reason="agent_gone", tail=tail,
        ledger_state=ledger_state or rec.get("state"), pane=rec.get("pane"),
        tab=rec.get("tab"))


@contextmanager
def _config_lock():
    lock_dir = os.path.expanduser("~/.herdr")
    os.makedirs(lock_dir, exist_ok=True)
    with open(os.path.join(lock_dir, "config.lock"), "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def _write_temp(path, text, mode=None):
    fd, tmp = tempfile.mkstemp(prefix=".herd-", dir=os.path.dirname(path))
    try:
        if mode is not None:
            os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            fd = -1
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        return tmp
    except Exception:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise


def _toml_basic(value):
    out = ['"']
    escapes = {'"': '\\"', "\\": "\\\\", "\b": "\\b", "\t": "\\t",
               "\n": "\\n", "\f": "\\f", "\r": "\\r"}
    for ch in value:
        code = ord(ch)
        if ch in escapes:
            out.append(escapes[ch])
        elif code <= 0x1f or code == 0x7f:
            out.append(f"\\u{code:04X}")
        elif 0xd800 <= code <= 0xdfff:
            raise RuntimeError("Codex config cannot represent cwd containing invalid UTF-8")
        else:
            out.append(ch)
    out.append('"')
    return "".join(out)


def _stat_id(st):
    return st.st_mtime_ns, st.st_size, st.st_ino


def _install(path, tmp, st):
    """Stat-gated atomic replace; false means the caller must retry."""
    if st is None:
        try:
            os.link(tmp, path)  # creation that cannot clobber a racing creator
        except FileExistsError:
            return False
        return True
    try:
        if _stat_id(os.stat(path)) != _stat_id(st):
            return False
    except FileNotFoundError:
        return False
    os.replace(tmp, path)
    return True


def pretrust(kind, cwd):
    """Best-effort trust-store seed for absent entries.

    Existing or invalid entries fall through to exit 3; see LORE.md."""
    cwd = os.path.realpath(cwd)
    if kind == "codex":
        path = os.path.expanduser("~/.codex/config.toml")
        with _config_lock():
            for _ in range(3):
                try:
                    with open(path, encoding="utf-8", newline="") as f:
                        text, st = f.read(), os.fstat(f.fileno())
                except FileNotFoundError:
                    text, st = "", None
                except UnicodeError:
                    return  # not ours to fix; dialog falls through
                try:
                    projects = tomllib.loads(text).get("projects", {})
                except tomllib.TOMLDecodeError:
                    return
                if not isinstance(projects, dict) or cwd in projects:
                    return  # trusted already, or a layout we don't rewrite
                gap = "" if not text or text.endswith("\n") else "\n"
                candidate = (text + gap + f'\n[projects.{_toml_basic(cwd)}]\n'
                             'trust_level = "trusted"\n')
                os.makedirs(os.path.dirname(path), exist_ok=True)
                tmp = _write_temp(path, candidate,
                                  st.st_mode & 0o7777 if st is not None else None)
                try:
                    if _install(path, tmp, st):
                        return
                finally:
                    try:
                        os.unlink(tmp)
                    except FileNotFoundError:
                        pass
    elif kind == "claude":
        path = os.path.expanduser("~/.claude.json")
        with _config_lock():
            for _ in range(3):
                try:
                    with open(path, encoding="utf-8") as f:
                        st = os.fstat(f.fileno())
                        data = json.load(f)
                except (FileNotFoundError, json.JSONDecodeError, UnicodeError):
                    return  # don't guess at a missing/corrupt store; dialog fails closed
                if not isinstance(data, dict):
                    return
                projects = data.setdefault("projects", {})
                if not isinstance(projects, dict):
                    return
                project = projects.setdefault(cwd, {})
                if not isinstance(project, dict) or project.get("hasTrustDialogAccepted"):
                    return
                project["hasTrustDialogAccepted"] = True
                tmp = _write_temp(path, json.dumps(data, indent=2) + "\n",
                                  st.st_mode & 0o7777)
                try:
                    if _install(path, tmp, st):
                        return
                finally:
                    try:
                        os.unlink(tmp)
                    except FileNotFoundError:
                        pass


def notify(title, body, sound="done"):
    rc, d = herdr("notification", "show", title, "--body", body, "--sound", sound)
    shown = d.get("result", {}).get("shown", False)
    if not shown:
        t = title.replace("\\", "").replace('"', "'")
        b = body.replace("\\", "").replace('"', "'")
        subprocess.run(["osascript", "-e",
                        f'display notification "{b}" with title "{t}"'],
                       capture_output=True)
    return shown


# ---------- commands ----------

def _ensure_herd_gitignored():
    # ponytail: unlocked check-then-append; two concurrent first spawns can
    # at worst duplicate the line.
    project = os.path.realpath(PROJECT)
    if not os.path.exists(os.path.join(project, ".git")):
        return
    path = os.path.join(project, ".gitignore")
    content = open(path).read() if os.path.exists(path) else ""
    if any(line.strip().strip("/") == ".herd" for line in content.splitlines()):
        return
    with open(path, "a") as f:
        f.write(("" if not content or content.endswith("\n") else "\n") + ".herd/\n")


def _spawn_cwd_warning(cwd):
    project = os.path.realpath(PROJECT)
    resolved = os.path.realpath(cwd)
    if not resolved.startswith(project + os.sep):
        return None
    top = git(resolved, "rev-parse", "--show-toplevel")
    if top.returncode == 0 and os.path.realpath(top.stdout.strip()) == resolved:
        return None
    return (f"spawn cwd {resolved} is a subdirectory of the project root "
            f"{project}; sub-lane cwd must be the project root or a worktree "
            "(nested .herd/ = forked ledger, unledgered lane)")

def _create_spawn_target(lane, cwd, use_worktree, env):
    branch = workspace = git_wt = None
    base = None
    targs = None
    if use_worktree:
        p = git(cwd, "symbolic-ref", "--short", "HEAD")
        base = p.stdout.strip()
        if p.returncode != 0 or not base:
            die("project HEAD is detached; check out a branch before "
                "spawning worktree lanes")
        branch = f"lane/{lane}"
        if env:
            git_wt = os.path.realpath(cwd)
            wt_path = os.path.join(WORKTREES,
                                   f"{os.path.basename(git_wt)}-{lane}")
            os.makedirs(WORKTREES, exist_ok=True)
            have = git(cwd, "show-ref", "--verify", "--quiet",
                       f"refs/heads/{branch}").returncode == 0
            wargs = (["worktree", "add", wt_path, branch] if have
                     else ["worktree", "add", "-b", branch, wt_path])
            p = git(cwd, *wargs)
            if p.returncode != 0:
                die(f"git worktree add failed: {(p.stdout + p.stderr).strip()}")
            targs = ["tab", "create", "--no-focus", "--label", lane,
                     "--cwd", wt_path, "--env", env]
        else:
            rc, d = herdr("worktree", "create", "--cwd", cwd,
                          "--branch", branch, "--label", lane, "--no-focus")
            if rc != 0:
                die(f"worktree create failed: {d}")
    else:
        wt_path = cwd
        targs = ["tab", "create", "--no-focus", "--label", lane, "--cwd", cwd]
        if env:
            targs += ["--env", env]
    if targs:
        if WORKSPACE:
            targs += ["--workspace", WORKSPACE]
        rc, d = herdr(*targs)
        if rc != 0:
            if git_wt:
                git(git_wt, "worktree", "remove", "--force", wt_path)
            die(f"tab create failed: {d}")
    res = d["result"]
    pane = res["root_pane"]["pane_id"]
    tab = res["tab"]["tab_id"]
    if use_worktree and not env:
        wt_path = res["root_pane"]["cwd"]
        workspace = res["workspace"]["workspace_id"]
    return {"pane": pane, "tab": tab, "cwd": wt_path, "base": base,
            "branch": branch, "workspace": workspace, "git_worktree": git_wt}


def _cleanup_spawn_target(target):
    if target["workspace"]:
        herdr("worktree", "remove", "--workspace", target["workspace"], "--force")
    else:
        herdr("tab", "close", target["tab"])
        if target["git_worktree"]:
            git(target["git_worktree"], "worktree", "remove", "--force",
                target["cwd"])


def cmd_spawn(argv):
    _refuse_new_home_ledger()
    lane = argv[0]
    kind = None
    for j, arg in enumerate(argv[1:], 1):
        if arg == "--":
            break
        if arg == "--kind":
            if j + 1 >= len(argv):
                die("--kind requires a value")
            kind = argv[j + 1]
    baked = baked_flag_arity(kind) if kind else {}
    cwd, extra, use_worktree, profile = PROJECT, [], False, None
    no_nudge = False
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--kind":
            kind = argv[i + 1]; i += 2
        elif a == "--cwd":
            cwd = argv[i + 1]; i += 2
        elif a == "--worktree":
            use_worktree = True; i += 1
        elif a == "--no-nudge":
            no_nudge = True; i += 1
        elif a == "--profile":
            profile = argv[i + 1]; i += 2
        elif a == "--":
            extra = argv[i + 1:]; break
        elif a in baked:
            arity = baked[a]
            if arity and i + 1 >= len(argv):
                die(f"{a} requires a value")
            print(f"note: ignoring duplicate {kind} launch flag {a} "
                  "because herd already supplies it", file=sys.stderr)
            i += 1 + arity
        else:
            die(f"unknown arg {a}")
    if not kind:
        die("--kind required")
    cwd = os.path.realpath(os.path.join(PROJECT, cwd))
    _ensure_herd_gitignored()
    cwd_warning = None if use_worktree else _spawn_cwd_warning(cwd)
    # --profile <name>: pi lane runs with PI_CODING_AGENT_DIR=~/.pi/agent-<name>
    # (a config dir sharing auth/models/npm with ~/.pi/agent via symlinks but
    # its own settings.json/extensions, for models needing a nonstandard stack).
    env = None
    if profile:
        if kind != "pi":
            die("--profile is pi-only")
        pdir = os.path.expanduser(f"~/.pi/agent-{profile}")
        os.path.isdir(pdir) or die(f"pi profile dir {pdir} does not exist")
        env = f"PI_CODING_AGENT_DIR={pdir}"
    alive = live_agents()
    if lane in alive and alive[lane].get("agent") == kind:
        a = alive[lane]
        old = load()["lanes"].get(lane) or {}
        acwd = os.path.realpath(a.get("cwd") or "/nonexistent")
        # identity: same pane as recorded, or cwd inside THIS project or the
        # lane's own recorded worktree — never a mere string prefix, never
        # the global worktree root
        same_pane = old.get("pane") == a["pane_id"]
        proj = os.path.realpath(PROJECT)
        in_proj = acwd == proj or acwd.startswith(proj + os.sep)
        own_wt = old.get("cwd") and acwd == os.path.realpath(old["cwd"])
        if not (same_pane or in_proj or own_wt):
            die(f"live agent '{lane}' does not match this project "
                f"(cwd {acwd}); pick another lane name")

        def adopt(led):
            rec = led["lanes"].setdefault(lane, {})
            # ownership survives only when the live agent is the very
            # pane we created; a rebound name is not ours to close
            rec["ours"] = bool(rec.get("ours")) and same_pane
            rec.update(kind=kind, pane=a["pane_id"], tab=a["tab_id"])
            rec.setdefault("state", "queued")
            return rec["pane"]
        pane = mutate(adopt)
        out = {"ok": True, "lane": lane, "adopted": True, "pane": pane}
        if cwd_warning:
            out["warning"] = cwd_warning
        print(json.dumps(out))
        return
    kargs = KIND_ARGS.get(kind, []) + list(extra)
    target = None
    for attempt in range(2):
        target = _create_spawn_target(lane, cwd, use_worktree, env)
        try:
            pretrust(kind, target["cwd"])
        except Exception as exc:
            # best-effort: a pretrust miss means a trust dialog, and the exit-3
            # dialog path already handles that — never abort the spawn for it
            print(f"pretrust skipped for {kind}: {exc}", file=sys.stderr)
        args = ["agent", "start", lane, "--kind", kind,
                "--pane", target["pane"]]
        if kargs:
            args += ["--", *kargs]
        for _ in range(10):  # fresh tab's shell may not be at its prompt yet
            rc, d = herdr(*args)
            if rc == 0 or "agent_pane_busy" not in json.dumps(d):
                break
            time.sleep(1)
        if rc == 0:
            break
        _cleanup_spawn_target(target)
        timed_out = "timed out waiting for agent startup" in json.dumps(d).lower()
        if timed_out and attempt == 0:
            print("note: agent startup timed out; cleaned up the partial spawn "
                  "and retrying once", file=sys.stderr)
            continue
        die(f"agent start failed: {d}")
    # Every pi spawn verifies the model baked into KIND_ARGS (or its override)
    # against pi-powerline's plain-text breadcrumb (display name, e.g.
    # "Claude Fable 5" for claude-bridge/claude-fable-5). Advisory, never
    # fatal: verified false means the orchestrator must check before sending.
    model_req = model_ok = None
    if kind == "pi":
        for j, a in enumerate(kargs):
            if a == "--model" and j + 1 < len(kargs):
                model_req = kargs[j + 1]  # last one wins, matching pi itself
    if model_req:
        # pi accepts "--model <id>:<thinking>"; the breadcrumb shows only the
        # model (thinking renders abbreviated, e.g. medium -> "med"), so strip
        # the suffix before deriving expected tokens
        want = [t for t in re.split(r"[^a-z0-9]+",
                model_req.rsplit("/", 1)[-1].split(":", 1)[0].lower()) if t]
        deadline = time.time() + 35  # banners can take 20-30s to render
        model_ok = False
        while time.time() < deadline:
            toks = set(re.split(r"[^a-z0-9]+", (read_pane(lane) or "").lower()))
            if want and all(t in toks for t in want):
                model_ok = True
                break
            time.sleep(3)
    rec = {**target, "kind": kind, "state": "queued", "ours": True}
    if profile:
        rec["profile"] = profile
    if no_nudge:
        rec["no_nudge"] = True
    if model_req:
        rec["model"] = model_req
    mutate(lambda led: led["lanes"].__setitem__(lane, rec))
    out = {"ok": True, "lane": lane, "pane": target["pane"],
           "tab": target["tab"], "cwd": target["cwd"],
           "branch": target["branch"]}
    if model_req:
        out["model"] = model_req
        out["model_verified"] = model_ok
    if cwd_warning:
        out["warning"] = cwd_warning
    print(json.dumps(out))


def cmd_send(argv):
    lane = argv[0]
    src, review, state = None, False, None
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--file":
            src = open(argv[i + 1]).read(); i += 2
        elif a == "--review":
            review = True; i += 1
        elif a == "--state":
            state = argv[i + 1]; i += 2
        else:
            src = a; i += 1
    if src is None:
        src = sys.stdin.read()
    if not src.strip():
        die("refusing to send an empty prompt")
    load()["lanes"].get(lane) or die(f"unknown lane {lane}")
    tok = "REPORT-END-" + secrets.token_hex(3)
    prompt = src
    ffile = None
    if review:
        def bump(led):
            r = led["lanes"][lane]
            r["reviews"] = r.get("reviews", 0) + 1
            r["findings"] = os.path.join(HERD_DIR,
                                         f"findings-{lane}-{r['reviews']}.json")
            r["findings_token"] = None
            return r["findings"]
        ffile = mutate(bump)
        try:
            os.unlink(ffile)
        except FileNotFoundError:
            pass
        prompt += REVIEW_FOOTER.format(ffile=ffile)
    prompt += FOOTER.format(tok=tok)
    delivered, attempts, _ = deliver(lane, prompt, tok.lower())
    if not delivered:
        die(f"prompt to {lane} not delivered after {attempts} attempts", 2)

    def fin(led):
        r = led["lanes"][lane]
        r["token"] = tok
        r["findings"] = ffile
        r["findings_token"] = tok if review else None
        if state:
            r["state"] = state
    mutate(fin)
    print(json.dumps({"ok": True, "lane": lane, "attempts": attempts, "token": tok,
                      "findings": ffile}))


def cmd_watch(argv):
    if not argv or "--help" in argv or "-h" in argv:
        print("usage: herd watch [--any] <lane> [<lane> ...] [--text] "
              "[--resume] [--timeout SECONDS] [--nudge-after SECONDS] "
              "[--no-nudge]\n\n"
              "Default timeout: 1200s. An idle lane with no report token is "
              "nudged once after --nudge-after seconds of quiet (default 600); "
              "--no-nudge (or `herd spawn --no-nudge`, for orchestrator / "
              "pseudo-orchestrator lanes that idle on their own sub-lanes) "
              "never nudges.\n"
              "exit 4 with advanced:true = re-arm, not escalate; fix rounds "
              "with 8+ findings or an engine rewrite → --timeout 3600")
        return
    timeout, text, any_mode, resume, lanes = 1200, False, False, False, []
    nudge_after, no_nudge = 600, False
    i = 0
    while i < len(argv):
        if argv[i] == "--timeout":
            try:
                timeout = int(argv[i + 1])
            except (IndexError, ValueError):
                die("--timeout requires an integer number of seconds")
            i += 2
        elif argv[i] == "--nudge-after":
            try:
                nudge_after = int(argv[i + 1])
            except (IndexError, ValueError):
                die("--nudge-after requires an integer number of seconds")
            i += 2
        elif argv[i] == "--no-nudge":
            no_nudge = True; i += 1
        elif argv[i] == "--text":
            text = True; i += 1
        elif argv[i] == "--any":
            any_mode = True; i += 1
        elif argv[i] == "--resume":
            resume = True; i += 1
        elif argv[i].startswith("-"):
            die(f"unknown arg {argv[i]}")
        else:
            lanes.append(argv[i]); i += 1
    if not lanes:
        die("watch requires at least one lane")
    if len(lanes) > 1 and not any_mode:
        die("multiple lanes require --any")

    watches = {}
    led = load()
    # Twelve quiet polls (~60 s) outlast status lag; the nudge waits much
    # longer (default 600 s) because orchestrator lanes legitimately idle for
    # many minutes on their own sub-lanes.
    idle_poll_limit = 12
    nudge_poll_limit = max(idle_poll_limit, -(-nudge_after // 5))
    for lane in lanes:
        rec = led["lanes"].get(lane) or die(f"unknown lane {lane}")
        tok = rec.get("token") or die(f"lane {lane} has no outstanding prompt token")
        watches[lane] = {
            "token": tok,
            "consumed": rec.get("watched_token") == tok,
            "sentinel": re.compile(rf"^\s*{re.escape(tok)}\s*$", re.M),
            "nudged": rec.get("nudged_token") == tok,
            "no_nudge": no_nudge or bool(rec.get("no_nudge")),
            "blocked_polls": 0,
            "idle_polls": 0,
            "history": [],  # last 3 (status, revision, tail) samples
        }

    def print_result(result, fallback=""):
        if text:
            output = result["tail"] or fallback
            print(output, end="" if output.endswith("\n") else "\n")
        else:
            print(json.dumps(result))

    def advanced(a, b):
        # herdr's pane revision is the truth; tail equality is the fallback
        # (claude panes re-render spinner verbs, so tails never settle).
        if a[1] is not None and b[1] is not None:
            return a[1] != b[1]
        return a[2] != b[2]

    def mark(lane, watch, field):
        """Atomically stamp `field` with this watch's token; False if a newer
        send superseded it or another watch got there first."""
        def fn(current):
            rec = current["lanes"].get(lane, {})
            ok = (rec.get("token") == watch["token"]
                  and rec.get("watched_token") != watch["token"]
                  and rec.get(field) != watch["token"])
            if ok:
                rec[field] = watch["token"]
            return rec.get("token"), ok
        return mutate(fn)

    def finish(lane, watch, st, tail, reason=None):
        current_token, claimed = mark(lane, watch, "watched_token")
        if current_token != watch["token"]:
            die(f"watch for lane {lane} was superseded by a newer send", 4,
                lane=lane, reason="superseded", tail=tail[-3000:],
                watched_token=watch["token"], current_token=current_token)
        if not claimed:
            watch["consumed"] = True
            return False
        result = {"ok": True, "lane": lane, "status": st, "tail": tail[-3000:]}
        if reason:
            result["reason"] = reason
        print_result(result)
        return True

    def findings_ready(path):
        try:
            with open(path) as f:
                return isinstance(json.load(f), list)
        except (TypeError, OSError, json.JSONDecodeError):
            return False

    def nudge(lane, watch):
        watch["nudged"] = True
        _, claimed = mark(lane, watch, "nudged_token")
        if claimed:
            deliver(lane, "If your task is finished, send the final report "
                    "(plain markdown, no box-drawing tables) ending with a "
                    f"lone line {watch['token']}. If you are still working — "
                    "including waiting on background lanes/tasks — do NOT "
                    "reply to this message.",
                    "do not reply to this message", attempts=3, polls=3)

    deadline = time.time() + timeout
    while time.time() < deadline:
        for lane, watch in watches.items():
            try:
                tail = read_pane(lane, 400)
            except Exception:
                tail = ""
            st = agent_status(lane)
            revision = agent_revision(lane) if st in {"idle", "done"} else None
            sample = (st, revision, tail)
            watch["history"] = (watch["history"] + [sample])[-3:]
            rec = load()["lanes"].get(lane, {})
            if st is None and (rec.get("closing")
                               or rec.get("state") == "closed"):
                result = {"ok": True, "lane": lane, "reason": "closed",
                          "tail": tail[-3000:]}
                print_result(result, f"lane {lane} closed")
                return
            if resume and watch["consumed"]:
                result = {"ok": True, "lane": lane, "status": st,
                          "reason": "already-reported", "tail": tail[-3000:]}
                print_result(result, f"lane {lane} already reported")
                return
            if st is None:
                notify(f"lane {lane} needs you", "worker agent is gone", "request")
                die_agent_gone(lane, tail[-3000:], rec)

            current_token = rec.get("token")
            if current_token != watch["token"]:
                die(f"watch for lane {lane} was superseded by a newer send", 4,
                    lane=lane, reason="superseded", tail=tail[-3000:],
                    watched_token=watch["token"], current_token=current_token)
            sentinel_present = bool(watch["sentinel"].search(tail))
            if not watch["consumed"] and sentinel_present and st != "working":
                if finish(lane, watch, st, tail):
                    return
                continue

            hist = watch["history"]
            quiet = (st in {"idle", "done"}
                     and (len(hist) < 2 or not advanced(hist[-2], hist[-1])))
            watch["idle_polls"] = watch["idle_polls"] + 1 if quiet else 0
            if (watch["idle_polls"] >= idle_poll_limit
                    and not watch["consumed"] and not sentinel_present):
                if (rec.get("findings_token") == watch["token"]
                        and findings_ready(rec.get("findings"))):
                    if finish(lane, watch, st, tail, "findings-file"):
                        return
                    continue
                if (not watch["nudged"] and not watch["no_nudge"]
                        and watch["idle_polls"] >= nudge_poll_limit):
                    nudge(lane, watch)
            if st == "blocked":
                # watch NEVER answers dialogs; only persistent blocked state
                # is escalated, because status can lag after a dialog clears.
                watch["blocked_polls"] += 1
                if watch["blocked_polls"] >= 3:
                    notify(f"lane {lane} needs you",
                           "blocked on a dialog; read the pane and answer it",
                           "request")
                    die(f"lane {lane} blocked on a dialog; pane tail:\n"
                        + tail[-1500:], 3, lane=lane, reason="dialog",
                        tail=tail[-1500:])
            else:
                watch["blocked_polls"] = 0
        time.sleep(5)
    names = ", ".join(lanes)
    notify(f"lane {names} needs you", f"watch timed out after {timeout}s", "request")
    statuses = {lane: (w["history"][-1][0] if w["history"] else None)
                for lane, w in watches.items()}
    moved = {lane: any(advanced(a, b) for a, b in zip(w["history"], w["history"][1:]))
             for lane, w in watches.items()}
    die(f"watch {names} timed out after {timeout}s", 4, reason="timeout",
        agent_status=statuses if any_mode else statuses[lanes[0]],
        advanced=moved if any_mode else moved[lanes[0]])


def cmd_status(_argv):
    led = load()
    alive = live_agents()
    rows = []
    for lane, rec in led["lanes"].items():
        a = alive.get(lane)
        liveness = "live" if a and a["agent"] == rec["kind"] else "DEAD"
        rows.append(f"{lane:16} {rec['kind']:7} {rec.get('state','?'):14} "
                    f"{liveness:5} task: {rec.get('task','-')}")
    print(f"ship_mode: {led.get('ship_mode', 'scratch')}")
    print("\n".join(rows) if rows else "no lanes")


def cmd_set(argv):
    def apply(led):
        if argv[0] == "ship_mode":
            led["ship_mode"] = argv[1]
            return
        rec = led["lanes"].get(argv[0]) or die(f"unknown lane {argv[0]}")
        for kv in argv[1:]:
            k, _, v = kv.partition("=")
            # Closed is terminal: reject, rather than silently dropping, a
            # late state update racing teardown.
            if k == "state" and rec.get("state") == "closed":
                die(f"lane {argv[0]} is closed; state is terminal")
            rec[k] = v
    mutate(apply)
    print(json.dumps({"ok": True}))


def cmd_triage(argv):
    ffile = argv[0]
    backlog = argv[argv.index("--backlog") + 1] if "--backlog" in argv else None
    promoted = set()
    if "--promote" in argv:
        try:
            value = argv[argv.index("--promote") + 1]
        except IndexError:
            die("--promote requires a comma-separated finding ID list")
        promoted = {x for x in value.split(",") if x}
        if not promoted:
            die("--promote requires a comma-separated finding ID list")
    findings = json.load(open(ffile))
    if not isinstance(findings, list) or any(not isinstance(f, dict) for f in findings):
        die("findings file is not a JSON array of objects")
    known_ids = {str(f["id"]) for f in findings if "id" in f}
    missing = promoted - known_ids
    if missing:
        die("unknown finding id(s): " + ", ".join(sorted(missing)))
    # fail closed: unknown severities and explicitly promoted findings are
    # handed back, never silently backlogged
    handback = [f for f in findings
                if f.get("severity") not in SEVERITIES
                or f["severity"] in HANDBACK_SEVS
                or str(f.get("id")) in promoted]
    rest = [f for f in findings if f not in handback]
    if rest and not backlog:
        die(f"{len(rest)} non-blocking findings but no --backlog file given; "
            "refusing to drop them")
    if rest:
        lines = [f"- [{f.get('severity','?')}] {f.get('file','?')}:{f.get('line','?')} — "
                 f"{f.get('symptom','')}" for f in rest]
        try:
            text = open(backlog).read()
        except FileNotFoundError:
            text = ""
        if "## Bugs" not in text:
            text += "\n## Bugs\n"
        text = text.rstrip("\n") + "\n" + "\n".join(lines) + "\n"
        with open(backlog, "w") as f:
            f.write(text)
    print(json.dumps({"ok": True, "handback": handback, "backlogged": len(rest),
                      "backlog_file": backlog if rest else None}))


def cmd_land(argv):
    lane = argv[0]
    led = load()
    rec = led["lanes"].get(lane) or die(f"unknown lane {lane}")
    mode = led.get("ship_mode", "scratch")
    if mode == "scratch":
        print(json.dumps({"ok": True, "lane": lane, "mode": mode,
                          "note": "scratch mode: work is already in the tree"}))
        return
    if not rec.get("branch"):
        # merge/pr: a missing worktree record must never look like success —
        # a silent "ok" here once nearly shipped an unmerged branch
        br = f"lane/{lane}"
        exists = git(PROJECT, "show-ref", "--verify", "--quiet",
                     f"refs/heads/{br}").returncode == 0
        hint = (f"branch {br} exists in the repo but is not in the ledger — "
                f"restore the record (herd set {lane} branch={br} base=<base>) "
                f"and land again, or merge by hand (git merge --no-ff {br})"
                if exists else
                f"no branch {br} exists either; this lane never had a "
                f"worktree, so there is nothing herd can merge")
        die(f"{mode} ship_mode but lane {lane} has no worktree/branch "
            f"metadata; refusing to silently skip the merge. {hint}", 4)
    if mode == "pr":
        print(json.dumps({"ok": True, "lane": lane, "mode": "pr",
                          "note": "pr mode: herd does not land locally — have the "
                                  "lane push its branch and open the PR per the "
                                  "project's contributing docs"}))
        return
    state = rec.get("state")
    review_state = rec.get("closed_from") if state == "closed" else state
    if review_state not in LANDABLE:
        detail = (f"closed from '{review_state}'" if state == "closed" else f"'{state}'")
        die(f"review gate: lane {lane} is {detail} — set state=reviewed "
            "after its review passes before closing or landing", 4)
    if rec.get("cwd") and os.path.isdir(rec["cwd"]):
        paths = dirty_paths(rec["cwd"])
        if paths["untracked"] or paths["modified"]:
            die(f"lane {lane} worktree has uncommitted changes; have the lane commit "
                "or discard them before landing", 4, **paths)
    base = rec.get("base") or "main"
    cur = git(PROJECT, "symbolic-ref", "--short", "HEAD").stdout.strip()
    if cur != base:
        die(f"project is on branch '{cur}' but lane {lane} was cut from '{base}'; "
            "check out the base branch before landing", 4)
    paths = dirty_paths(PROJECT)
    if paths["untracked"] or paths["modified"]:
        die("project tree is dirty; refusing to merge into it", 4, **paths)
    br = rec["branch"]
    p = git(PROJECT, "merge", "--no-ff", "--no-edit", br)
    if p.returncode != 0:
        merging = os.path.exists(os.path.join(PROJECT, ".git", "MERGE_HEAD"))
        if merging:
            files = git(PROJECT, "diff", "--name-only",
                        "--diff-filter=U").stdout.split()
            git(PROJECT, "merge", "--abort")
            die(json.dumps({"conflict": True, "lane": lane, "branch": br,
                            "files": files,
                            "detail": (p.stdout + p.stderr)[-800:]}), 3)
        die(f"merge failed (not a conflict): {(p.stdout + p.stderr)[-800:]}")
    mutate(lambda led: led["lanes"][lane].__setitem__("state", "done"))
    print(json.dumps({"ok": True, "lane": lane, "merged": br}))


def _integrated(path, worktree):
    """The lane's copy is integrated when the project has the identical blob,
    or that exact blob was committed to the project at some point (parent
    integrated it, then evolved it)."""
    def blob(cwd):
        p = git(cwd, "hash-object", "--", path)
        return p.stdout.strip() if p.returncode == 0 else None
    lane_blob = blob(worktree)
    if not lane_blob:
        return False
    if lane_blob == blob(PROJECT):
        return True
    p = git(PROJECT, "log", "-1", f"--find-object={lane_blob}", "--format=%H",
            "--", path)
    return p.returncode == 0 and bool(p.stdout.strip())


def cmd_close(argv):
    lane = argv[0]
    force = "--force" in argv
    integrated = "--integrated" in argv
    led = load()
    rec = led["lanes"].get(lane) or die(f"unknown lane {lane}")
    if not rec.get("ours"):
        die(f"lane {lane} tab was not created by herd; refusing to close")
    st = agent_status(lane)
    # only affirmatively settled agents (or no agent at all) may be closed;
    # `unknown` means herdr can't classify it — that is not settled
    if st not in (None, "idle", "done") and not force:
        die(f"lane {lane} agent is {st}; read its pane first (--force to override)", 4)
    is_worktree = bool(rec.get("workspace") or rec.get("git_worktree"))
    if is_worktree and not force and os.path.isdir(rec.get("cwd", "")):
        paths = dirty_paths(rec["cwd"])
        if paths["untracked"] or paths["modified"]:
            if integrated:
                dirty = list(dict.fromkeys(paths["untracked"] + paths["modified"]))
                differing = [path for path in dirty
                             if not _integrated(path, rec["cwd"])]
                if differing:
                    die(f"lane {lane} worktree has changes not integrated in "
                        "the project tree", 4, differing=differing)
            else:
                die(f"lane {lane} worktree has uncommitted work; commit/land "
                    "it, use --integrated after copying it to the project, or "
                    "--force to discard", 4)

    # A transient marker lets a concurrent watch recognize intentional
    # teardown without claiming that teardown has succeeded yet.
    mutate(lambda led: led["lanes"][lane].__setitem__("closing", True))

    def finish_close(led):
        r = led["lanes"][lane]
        if r.get("state") != "closed":
            r["closed_from"] = r.get("state")
        r.update(state="closed", tab=None, workspace=None)
        r.pop("closing", None)

    if rec.get("workspace"):
        rc, d = herdr("worktree", "remove", "--workspace", rec["workspace"],
                      "--force")
    elif rec.get("tab"):
        rc, d = herdr("tab", "close", rec["tab"])
    else:
        rc, d = 0, {}
    if rc != 0:
        tail = ""
        try:
            tail = read_pane(lane, 100)
        except Exception:
            pass
        if agent_status(lane) is not None:
            mutate(lambda led: led["lanes"][lane].pop("closing", None))
            die(f"close failed: {d}")
        mutate(finish_close)
        die_agent_gone(lane, tail[-1500:], rec,
                       "agent is gone; close could not reach its pane", "closed")

    # The pane is now deliberately gone. Commit terminal state before the
    # secondary git-worktree cleanup so even that failure cannot look like a
    # worker crash. closed_from keeps the review gate available to land.
    mutate(finish_close)
    if rec.get("git_worktree") and rec.get("cwd") and os.path.isdir(rec["cwd"]):
        p = git(rec["git_worktree"], "worktree", "remove",
                *(["--force"] if force or integrated else []), rec["cwd"])
        if p.returncode != 0:
            die(f"tab closed but git worktree remove failed: "
                f"{(p.stdout + p.stderr).strip()}")

    print(json.dumps({"ok": True, "lane": lane}))


def cmd_notify(argv):
    title = argv[0]
    body = argv[argv.index("--body") + 1] if "--body" in argv else ""
    sound = argv[argv.index("--sound") + 1] if "--sound" in argv else "done"
    print(json.dumps({"ok": True, "toast": notify(title, body, sound)}))


CMDS = {"spawn": cmd_spawn, "send": cmd_send, "watch": cmd_watch, "status": cmd_status,
        "set": cmd_set, "triage": cmd_triage, "land": cmd_land, "close": cmd_close,
        "notify": cmd_notify}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print("usage: herd " + "|".join(CMDS) + " ...", file=sys.stderr)
        sys.exit(2)
    CMDS[sys.argv[1]](sys.argv[2:])
